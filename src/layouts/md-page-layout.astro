---
// A layout for markdown pages. Not blog posts.
import PageHeader from "~/components/page-header.astro";
import Layout from "./Layout.astro";
import PageContainer from "./page-container.astro";
import ReadingSheet from "./reading-sheet.astro";

type Props = {
	frontmatter: {
		title: string;
		description?: string;
	};
};

const { frontmatter: post } = Astro.props;
if (post.title === undefined)
	throw new Error("Frontmatter page title missing. E.g. 'title: Moo'");
---

<Layout title={post.title} description={post.description}>
	<PageContainer>
		<article>
			{
				/* The title comes from frontmatter, never from a `#` in the body:
			every route names itself the same way, on the gradient. */
			}
			<ReadingSheet>
				<PageHeader
					slot="header"
					title={post.title}
					description={post.description}
				/>

				<div class="markdown">
					<slot />
				</div>
			</ReadingSheet>
		</article>
	</PageContainer>
</Layout>
