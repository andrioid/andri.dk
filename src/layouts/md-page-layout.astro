---
// A layout for markdown pages. Not blog posts.
import Layout from "./Layout.astro";
import PageContainer from "./page-container.astro";
import ReadingSheet from "./reading-sheet.astro";

type Props = {
	frontmatter: {
		title: string;
		description?: string;
	};
};

const { frontmatter: post } = Astro.props;
if (post.title === undefined)
	throw new Error("Frontmatter page title missing. E.g. 'title: Moo'");
---

<Layout title={post.title} description={post.description}>
	<PageContainer>
		<ReadingSheet>
			<article class="markdown">
				<slot />
			</article>
		</ReadingSheet>
	</PageContainer>
</Layout>
