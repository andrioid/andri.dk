---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Container from "~/components/container.astro";
import NavItems from "~/components/nav-items.astro";
import ProfileIcon from "~/components/profile-icon.astro";
import { resumeRaw } from "~/lib/cv";
import andratar from "../../public/img/coffee-art.jpg";

type Props = { isHome?: boolean };

const { isHome = false } = Astro.props;
---

{
	/* The night ground is fixed, not painted on the scroll container: it stays
	behind reading sheets and index grids alike, so the world never leaves. */
}
<div
	aria-hidden="true"
	class="fixed inset-0 -z-10 bg-linear-to-b from-primary-500 to-black"
>
</div>

<div class="flex min-h-dvh flex-col font-sans text-white">
	<Container as="header" class="py-4">
		<nav class="flex items-center justify-between gap-4">
			<a href="/" class="shrink-0">
				<span class="flex items-center text-white sm:mr-6">
					<Image
						alt=""
						src={andratar}
						class="inline-block h-8 w-8 rounded-full sm:mr-4"
					/>
					{
						!isHome && (
							<span class="hidden text-xl font-semibold tracking-tight drop-shadow-md sm:inline-block">
								Andri
							</span>
						)
					}
					<span class="sr-only">andri.dk, home</span>
				</span>
			</a>
			<ul class="flex flex-wrap justify-end gap-x-1 gap-y-2 text-sm">
				<NavItems />
			</ul>
		</nav>
	</Container>

	<main class="grow">
		<slot />
	</main>

	<footer class="flex shrink-0 justify-center gap-2 p-6 text-4xl">
		<a class="transition-colors hover:text-hover" href="/rss.xml">
			<Icon name="tabler:rss" />
			<span class="sr-only">RSS feed</span>
		</a>

		{resumeRaw.basics.profiles.map((p) => <ProfileIcon profile={p} />)}
	</footer>
</div>
