---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ActivityRail from "~/components/activity-rail.astro";
import ActivitySkeleton from "~/components/activity-skeleton.astro";
import Card from "~/components/card.astro";
import Container from "~/components/container.astro";
import PostCard from "~/components/post-card.astro";
import ProjectCard from "~/components/project-card.astro";
import Section from "~/components/Section.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";
import { getPosts } from "~/lib/cms";
import { resumeProcessed, resumeRaw } from "~/lib/cv";
import andratar from "../../public/img/coffee-art.jpg";
import SkillOverview from "./_cmp/skill-overview.astro";

const cv = resumeRaw;
const recentPosts = (await getPosts()).slice(0, 3);

// "Selected" means the ones with a public repo behind them: verifiable work,
// not a favourites list.
const projects = (await getCollection("project"))
	.filter((p) => !p.data.hidden && p.data.github)
	.slice(0, 3);
---

<Layout
	title={cv.basics.name}
	description={cv.basics.label}
	ogImage="/img/wave.svg"
>
	<PageContainer isHome={true}>
		<Container class="pb-12">
			<section
				class="flex min-h-[46dvh] flex-col items-center justify-center py-10 text-center lg:min-h-[58dvh] lg:items-start lg:text-left"
			>
				<Image
					alt=""
					src={andratar}
					width={320}
					height={320}
					class="mb-6 h-28 w-28 rounded-full ring-1 ring-white/20 sm:h-32 sm:w-32"
				/>
				<h1
					class="text-4xl font-bold text-white drop-shadow-lg md:text-6xl"
				>
					{cv.basics.name}
				</h1>
				<p class="mt-3 text-lg text-sky-300 drop-shadow-lg md:text-xl">
					{cv.basics.label}
				</p>
				<p class="mt-1 text-white/90 drop-shadow-sm">
					{cv.basics.location.city}, {cv.basics.location.countryCode}
				</p>
			</section>

			{
				/* The rail is a desktop panel; on a phone the stream becomes a
				short section in normal flow. */
			}
			<Section
				title="Recent activity"
				class="lg:hidden"
				action={{ href: "/activity/", label: "All activity" }}
			>
				<Card class="p-4">
					<ActivityRail server:defer limit={4} tone="dark">
						<ActivitySkeleton slot="fallback" rows={3} />
					</ActivityRail>
				</Card>
			</Section>

			<Section
				title="Recent posts"
				action={{ href: "/blog/", label: "All posts" }}
			>
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
					{
						recentPosts.map(({ data: p, ...post }) => (
							<PostCard
								title={p.title}
								id={post.id}
								description={p.description}
								date={p.date}
								draft={p.draft}
							/>
						))
					}
				</div>
			</Section>

			<Section
				title="Selected projects"
				action={{ href: "/projects/", label: "All projects" }}
			>
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
					{
						projects.map((project) => (
							<ProjectCard project={project} />
						))
					}
				</div>
			</Section>

			<Section title="Skills">
				<SkillOverview dt={resumeProcessed} />
			</Section>
		</Container>

		<Fragment slot="rail">
			<div
				class="flex items-baseline justify-between gap-3 px-5 pt-6 pb-3"
			>
				<h2
					class="text-sm font-semibold tracking-wide text-white uppercase"
				>
					Activity
				</h2>
				<a
					href="/activity/"
					class="text-xs text-sky-200 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 motion-reduce:transition-none"
				>
					All activity
				</a>
			</div>
			<div class="activity-rail min-h-0 grow overflow-y-auto px-5 pb-6">
				<ActivityRail server:defer limit={12} tone="dark">
					<ActivitySkeleton slot="fallback" rows={6} />
				</ActivityRail>
			</div>
		</Fragment>
	</PageContainer>
</Layout>

<style>
	.activity-rail {
		/* The fade zones sit on the container, not the content: the top one is
		exactly the padding, so at rest it dims nothing and only bites while
		scrolling. The bottom one signals the stream continues past the fold. */
		padding-top: 0.75rem;
		mask-image: linear-gradient(
			to bottom,
			transparent,
			#000 0.75rem,
			#000 calc(100% - 2.5rem),
			transparent
		);
		scrollbar-width: thin;
		scrollbar-color: rgb(255 255 255 / 0.25) transparent;
	}
</style>
