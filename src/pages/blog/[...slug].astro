---
// Find all blog posts to generate
import { render } from "astro:content";
import { BlueSkyInteractions } from "~/components/bluesky-interactions";
import Tag from "~/components/tag.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";
import ReadingSheet from "~/layouts/reading-sheet.astro";
import { getPost } from "~/lib/cms";
import { socialLinks } from "./_cmp/social-links-n8n";

const { slug } = Astro.params;
if (!slug) {
	//return Astro.redirect("/404");
	throw new Error("Missing param slug");
}

const post = await getPost(slug);
if (!post) {
	return new Response(null, {
		status: 404,
		statusText: "Not found",
	});
}
const { date, title, description, tags } = post.data;
const { Content } = (await render(post)) ?? {};

const someLinks = await socialLinks(slug);
---

<Layout
	title={title}
	description={description}
	ogImage={new URL(`/blog/${slug}.og`, Astro.site?.origin).toString()}
>
	<PageContainer width="narrow">
		<ReadingSheet>
			<header class="mb-8">
				<h1
					class="text-3xl leading-tight font-semibold tracking-tight text-gray-900 md:text-4xl"
				>
					{title}
				</h1>
				<p class="mt-2 text-sm text-slate-500">
					<time datetime={date.toISOString()}>
						{
							date.toLocaleDateString(undefined, {
								year: "numeric",
								month: "short",
								day: "numeric",
							})
						}
					</time>
				</p>
				{
					tags && tags.length > 0 && (
						<div class="mt-4 flex flex-wrap gap-2">
							{tags.map((t) => (
								<Tag tag={t} />
							))}
						</div>
					)
				}
			</header>

			<article class="markdown">
				{Content && <Content />}
			</article>

			<footer class="mt-10 border-t border-slate-200 pt-6">
				<p class="text-base font-light text-slate-600 italic">
					Thank you for reading my blog-post. I write my own articles
					(typos and all), like a damn monkey without any artificial
					intelligence help. If you enjoyed it, or even if you hated
					it. I'd appreciate the feedback.
				</p>

				{
					someLinks.atUri && (
						<div class="mt-6">
							<BlueSkyInteractions
								client:only="react"
								atUri={someLinks.atUri ?? ""}
							/>
						</div>
					)
				}
			</footer>
		</ReadingSheet>
	</PageContainer>
</Layout>
