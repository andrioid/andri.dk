---
// Find all blog posts to generate
import { render } from "astro:content";
import { BlueSkyInteractions } from "~/components/bluesky-interactions";
import PageHeader from "~/components/page-header.astro";
import Tag from "~/components/tag.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";
import ReadingSheet from "~/layouts/reading-sheet.astro";
import { getPost } from "~/lib/cms";
import { socialLinks } from "./_cmp/social-links-n8n";

const { slug } = Astro.params;
if (!slug) {
	//return Astro.redirect("/404");
	throw new Error("Missing param slug");
}

const post = await getPost(slug);
if (!post) {
	return new Response(null, {
		status: 404,
		statusText: "Not found",
	});
}
const { date, title, description, tags } = post.data;
const { Content } = (await render(post)) ?? {};

const someLinks = await socialLinks(slug);
---

<Layout
	title={title}
	description={description}
	ogImage={new URL(`/blog/${slug}.og`, Astro.site?.origin).toString()}
>
	<PageContainer>
		<article>
			<ReadingSheet>
				<PageHeader
					slot="header"
					title={title}
					description={description}
					eyebrow={{ href: "/blog/", label: "Blog" }}
				>
					<div
						class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2"
					>
						<time
							datetime={date.toISOString()}
							class="text-sm text-sky-200/85"
						>
							{
								date.toLocaleDateString(undefined, {
									year: "numeric",
									month: "short",
									day: "numeric",
								})
							}
						</time>
						{
							tags && tags.length > 0 && (
								<div class="flex flex-wrap gap-2">
									{tags.map((t) => (
										<Tag tag={t} tone="dark" />
									))}
								</div>
							)
						}
					</div>
				</PageHeader>

				<div class="markdown">
					{Content && <Content />}
				</div>

				<footer class="mt-10 border-t border-slate-200 pt-6">
					<p class="text-base font-light text-slate-600 italic">
						Thank you for reading my blog-post. I write my own
						articles (typos and all), like a damn monkey without any
						artificial intelligence help. If you enjoyed it, or even
						if you hated it. I'd appreciate the feedback.
					</p>

					{
						someLinks.atUri && (
							<div class="mt-6">
								<BlueSkyInteractions
									client:only="react"
									atUri={someLinks.atUri ?? ""}
								/>
							</div>
						)
					}
				</footer>
			</ReadingSheet>
		</article>
	</PageContainer>
</Layout>
