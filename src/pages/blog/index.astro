---
import Container from "~/components/container.astro";
import PageHeader from "~/components/page-header.astro";
import PostCard from "~/components/post-card.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";
import { getPosts } from "~/lib/cms";
import { isReadable, t } from "~/lib/i18n";

const { locale } = Astro.locals;
const allPosts = await getPosts();
---

<Layout
	title="Blog"
	description="Posts about building software, infrastructure and the web."
>
	<PageContainer>
		<Container class="pb-16">
			<PageHeader
				title={t(locale, "blog.title")}
				description={t(locale, "blog.intro")}
			/>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{allPosts.map(({ data: p, ...post }) => (
					<PostCard
						title={p.title}
						id={post.id}
						description={p.description}
						tags={p.tags}
						date={p.date}
						draft={p.draft}
						language={p.language}
						expanded={isReadable(p.language, Astro.locals)}
					/>
				))}
			</div>
		</Container>
	</PageContainer>
</Layout>
