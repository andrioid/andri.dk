---
import Container from "~/components/container.astro";
import PageHeader from "~/components/page-header.astro";
import PostCard from "~/components/post-card.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";
import { getPosts } from "~/lib/cms";

const allPosts = await getPosts();
---

<Layout
	title="Blog"
	description="Posts about building software, infrastructure and the web."
>
	<PageContainer>
		<Container class="pb-16">
			<PageHeader
				title="Blog"
				description="Notes on building software, infrastructure and the web, going back to 2019."
			/>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					allPosts.map(({ data: p, ...post }) => (
						<PostCard
							title={p.title}
							id={post.id}
							description={p.description}
							tags={p.tags}
							date={p.date}
							draft={p.draft}
						/>
					))
				}
			</div>
		</Container>
	</PageContainer>
</Layout>
