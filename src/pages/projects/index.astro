---
import { getCollection } from "astro:content";
import Container from "~/components/container.astro";
import PageHeader from "~/components/page-header.astro";
import ProjectCard from "~/components/project-card.astro";
import Layout from "~/layouts/Layout.astro";
import PageContainer from "~/layouts/page-container.astro";

const allProjects = await getCollection("project");
const filtered = allProjects.filter((p) => !p.data.hidden);
---

<Layout title="Projects" description="Things I have built and maintain.">
	<PageContainer>
		<Container class="pb-16">
			<PageHeader
				title="Projects"
				description="Things I have built and maintain, with the public repos behind them."
			/>
			<div class="grid gap-4 md:grid-cols-2">
				{filtered.map((project) => <ProjectCard project={project} />)}
			</div>
		</Container>
	</PageContainer>
</Layout>
