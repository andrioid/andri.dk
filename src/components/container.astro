---
import { twMerge } from "tailwind-merge";

/**
 * The one horizontal rhythm for the whole site. Every route sits inside this;
 * nothing declares its own gutters. Home included, no exceptions.
 */
interface Props {
	class?: string;
	as?: "div" | "section" | "header" | "footer";
}

const { class: className, as: Tag = "div" } = Astro.props;
---

<Tag
	class={twMerge("mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8", className)}
>
	<slot />
</Tag>
