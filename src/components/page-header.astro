---
/**
 * The h1 for an index route, on the gradient above the grid it introduces:
 * title, then description, both on the page's frame edge like everything else
 * out here — masthead, grid, footer.
 *
 * Reading routes do not use this. A document names itself on the paper, in the
 * same column as its body (see reading-sheet.astro).
 */
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<header class="pt-10 pb-6 sm:pt-14 sm:pb-8">
	<h1
		class="text-3xl font-semibold tracking-tight text-white drop-shadow-md sm:text-4xl"
	>
		{title}
	</h1>
	{
		/* Capped at the reading measure so a sentence does not run the full grid. */
	}
	{
		description && (
			<p class="mt-2 max-w-3xl text-base text-sky-100/80">
				{description}
			</p>
		)
	}
</header>
