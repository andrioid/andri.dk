---
import { twMerge } from "tailwind-merge";

type Props = {
	href: string;
	target?: string;
	active?: boolean;
};

const { href, target, active = false } = Astro.props;

// Glass at rest so the nav belongs to the same world as the panels below it;
// solid white when you are on the route, which is the only inversion in the bar.
const base =
	"inline-block rounded-md px-2.5 py-2 font-semibold transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:px-3";
const state = active
	? "bg-white text-primary-800"
	: "bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/20";
---

<li>
	<a
		{href}
		{target}
		aria-current={active ? "page" : undefined}
		class={twMerge(base, state)}
	>
		<slot />
	</a>
</li>
