---
import { CollectionEntry, render } from "astro:content";
import { getStars } from "~/lib/github-cache";
import Card from "./card.astro";
import Icon from "./Icon.astro";
import OptionalLink from "./optional-link.astro";
import Pill from "./pill.astro";
import Tag from "./tag.astro";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { Content } = await render(project);

// null when GitHub is unreachable or rate-limited: show the repo pill without a
// number rather than a lone star glyph.
const stars = project.data.github ? await getStars(project.data.github) : null;

// Where the card points: the project's own site if it has one, else its repo. A project
// with neither keeps a plain title rather than a link to nowhere.
const link =
	project.data.url ??
	(project.data.github
		? `https://github.com/${project.data.github}`
		: undefined);
---

<Card class="flex flex-col p-5">
	<h3 class="text-lg leading-snug font-medium text-white">
		<OptionalLink
			href={link}
			class="transition-colors hover:text-sky-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 motion-reduce:transition-none"
		>
			{project.data.title}
		</OptionalLink>
	</h3>

	{
		(project.data.github || project.data.tags) && (
			<div class="mt-2.5 flex flex-row flex-wrap gap-1.5">
				{project.data.github && (
					<Pill
						icon="github"
						tone="dark"
						url={`https://github.com/${project.data.github}`}
					>
						{stars === null ? (
							"github"
						) : (
							<>
								<Icon
									name="star-filled"
									class="inline h-3.5 w-3.5 text-amber-400"
								/>
								{stars}
							</>
						)}
					</Pill>
				)}

				{project.data.tags?.sort().map((tag) => (
					<Tag tag={tag} tone="dark" />
				))}
			</div>
		)
	}

	{
		/* Project blurbs are one to three plain paragraphs, so they get simple
		prose styling rather than the light-ground `.markdown` block. */
	}
	<div
		class="mt-3 space-y-3 text-sm leading-relaxed text-sky-100/80 [&_p]:m-0"
	>
		<Content />
	</div>
</Card>
