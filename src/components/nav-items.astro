---
import { t } from "~/lib/i18n";
import NavItem from "./NavItem.astro";

const { locale } = Astro.locals;
const NAV = [
	{ href: "/blog/", label: t(locale, "nav.blog") },
	{ href: "/projects/", label: t(locale, "nav.projects") },
	{ href: "/uses/", label: t(locale, "nav.uses") },
	{ href: "/now/", label: t(locale, "nav.now") },
];

// trailingSlash is "ignore", so normalise before comparing: /uses and /uses/
// are the same route, and /blog/2025/post/ is still inside /blog/.
const path = Astro.url.pathname;
const current = path.endsWith("/") ? path : `${path}/`;
---

{NAV.map(({ href, label }) => (
	<NavItem href={href} active={current.startsWith(href)}>
		{label}
	</NavItem>
))}
