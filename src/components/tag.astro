---
import Pill, { type Tone } from "./pill.astro";
import { IconType, supportedIcons } from "./Icon.astro";

interface Props {
	tag: string;
	tone?: Tone;
}

const { tag, tone = "light" } = Astro.props;

let iconName: IconType | undefined = undefined;
if (tag in supportedIcons) {
	iconName = tag as IconType;
}
---

<Pill icon={iconName} tone={tone}>{tag}</Pill>
