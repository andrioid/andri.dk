---
import { twMerge } from "tailwind-merge";

/**
 * The glass surface. Everything on an atmosphere route that needs to hold
 * content sits on one of these: translucent, blurred, hairline-ringed. Never a
 * drop shadow — a shadow does nothing over the night ground.
 *
 * Pass `href` to make the whole surface a link; hover then lifts the ring and
 * the fill rather than the box.
 */
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className } = Astro.props;

const base =
	"rounded-xl bg-primary-900/60 ring-1 ring-white/10 backdrop-blur-md";
const interactive =
	"group block transition-colors motion-reduce:transition-none hover:bg-primary-900/75 hover:ring-sky-300/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300";
---

{
	href ? (
		<a href={href} class={twMerge(base, interactive, className)}>
			<slot />
		</a>
	) : (
		<div class={twMerge(base, className)}>
			<slot />
		</div>
	)
}
