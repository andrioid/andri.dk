---
import ActivityFeed from "./activity-feed.astro";
import { getActivity, type ActivityKind } from "~/lib/activity";

/**
 * The activity feed as a deferred server island: the page ships immediately
 * with the skeleton below, and this streams in when the live collection
 * answers. No client JS, and a slow GitHub or Bluesky never holds a page.
 */
interface Props {
	limit?: number;
	tone?: "light" | "dark";
	/** Restrict the rail to these kinds. Omitted means every kind. */
	kinds?: Array<ActivityKind>;
}

const { limit = 12, tone = "dark", kinds } = Astro.props;
const items = await getActivity({ limit, kinds });
---

<ActivityFeed items={items} tone={tone} />
