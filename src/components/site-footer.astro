---
import { Icon } from "astro-icon/components";
import Container from "./container.astro";
import { resumeRaw } from "~/lib/cv";
import { LOCALES, t } from "~/lib/i18n";

/**
 * The closing colophon. Three columns: where else to go on the site, where else
 * to find Andri, and what this site is made of.
 *
 * The CV PDF and the email address are deliberately not linked here. /cv.pdf
 * exists but stays unadvertised, and the profiles are the contact path.
 */
const NETWORK_ICON: Record<string, string> = {
	GitHub: "tabler:brand-github",
	Mastodon: "tabler:brand-mastodon",
	Bluesky: "tabler:brand-bluesky",
	LinkedIn: "tabler:brand-linkedin",
	Twitter: "tabler:brand-x",
};

const { profiles } = resumeRaw.basics;
const year = new Date().getFullYear();

const { locale } = Astro.locals;
const here = Astro.url.pathname + Astro.url.search;

const SITE = [
	{ href: "/blog/", label: t(locale, "nav.blog") },
	{ href: "/projects/", label: t(locale, "nav.projects") },
	{ href: "/activity/", label: t(locale, "nav.activity") },
	{ href: "/uses/", label: t(locale, "nav.uses") },
	{ href: "/now/", label: t(locale, "nav.now") },
];

// The visitor's own language first; English stays one click away.
const FEEDS =
	locale === "en"
		? [{ href: "/rss.xml", label: t(locale, "footer.blogFeed") }]
		: [
				{
					href: `/rss.${locale}.xml`,
					label: t(locale, "footer.blogFeed"),
				},
				{
					href: "/rss.xml",
					label: t(locale, "footer.blogFeedEnglish"),
				},
			];

const link =
	"inline-flex items-center gap-2 text-sky-100/80 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 motion-reduce:transition-none";
const heading = "text-sm font-semibold tracking-wide text-sky-200 uppercase";
---

<Container as="footer" class="mt-12 border-t border-white/10 py-10 text-sm">
	<div class="grid gap-8 sm:grid-cols-3">
		<nav aria-labelledby="footer-site">
			<h2 id="footer-site" class={heading}>
				{t(locale, "footer.site")}
			</h2>
			<ul class="mt-3 space-y-2">
				{SITE.map((item) => (
					<li>
						<a class={link} href={item.href}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<nav aria-labelledby="footer-elsewhere">
			<h2 id="footer-elsewhere" class={heading}>
				{t(locale, "footer.elsewhere")}
			</h2>
			<ul class="mt-3 space-y-2">
				{profiles.map((p) => (
					<li>
						<a class={link} href={p.url} rel="me">
							<Icon
								class="h-4 w-4 shrink-0"
								name={NETWORK_ICON[p.network] ?? "tabler:link"}
							/>
							{p.network}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div>
			<h2 class={heading}>{t(locale, "footer.thisSite")}</h2>
			<ul class="mt-3 space-y-2">
				{FEEDS.map((feed) => (
					<li>
						<a class={link} href={feed.href}>
							<Icon class="h-4 w-4 shrink-0" name="tabler:rss" />
							{feed.label}
						</a>
					</li>
				))}
				<li>
					<a class={link} href="/activity.xml">
						<Icon class="h-4 w-4 shrink-0" name="tabler:rss" />
						{t(locale, "footer.activityFeed")}
					</a>
				</li>
				<li>
					<a class={link} href="https://github.com/andrioid/andri.dk">
						<Icon
							class="h-4 w-4 shrink-0"
							name="tabler:brand-github"
						/>
						{t(locale, "footer.source")}
					</a>
				</li>
			</ul>
		</div>
	</div>

	{/* iheartrss.com asks only for a link pointing at it, and sanctions a plain
		text one — so no 88×31 button: a borrowed wordmark is the logo wall DESIGN.md
		rules out. The heart is a glyph in running text, not an icon; the feed keeps
		filled icons for "a number follows". */}
	<p class="mt-8 text-xs text-sky-200/60">
		&copy; {year} Andri Óskarsson &middot;{" "}
		{t(locale, "footer.writingLicense")} &middot;{" "}
		{t(locale, "footer.codeLicense")} &middot;{" "}
		<a class={link} href="https://iheartrss.com/">
			I <span class="text-red-500">&hearts;</span> RSS
		</a>
	</p>

	<nav
		aria-label={t(locale, "footer.language")}
		class="mt-4 flex items-center gap-1 text-xs text-sky-200/60"
	>
		<span class="mr-1">{t(locale, "footer.language")}:</span>
		{LOCALES.map((l) => (
			<a
				href={`/lang?set=${l}&next=${encodeURIComponent(here)}`}
				hreflang={l}
				aria-current={l === locale ? "true" : undefined}
				class:list={[
					"rounded-sm px-1.5 py-0.5 uppercase underline-offset-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 motion-reduce:transition-none",
					l === locale
						? "bg-white/15 text-white"
						: "text-sky-100/80 hover:text-white hover:underline",
				]}
			>
				{l}
			</a>
		))}
	</nav>
</Container>
