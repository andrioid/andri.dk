{
  "compilerOptions": {
    "paths": {
      "@public/*": ["./public/*"],
      "~/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"]
    },
    "noUnusedLocals": false,
    "verbatimModuleSyntax": false,
    "strictNullChecks": true
  },
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["packages/react-cv/dist", "dist"]
}
