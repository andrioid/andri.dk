{
  "name": "andri.dk",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "node server.mjs",
    "lint": "oxlint .",
    "build": "astro build",
    "format": "prettier --write .",
    "verify:formatting": "prettier . --check",
    "verify:types": "tsc --noEmit",
    "preview": "astro preview",
    "letter": "TSX_TSCONFIG_PATH=scripts/tsconfig.json node --import tsx scripts/letter.ts",
    "deno": "deno run --allow-net --allow-read --allow-env ./dist/server/entry.mjs",
    "check": "astro check",
    "build:bin": "bun build --compile --packages external --outfile ./app server.mjs",
    "bundle": "bun build --target bun --bundle --packages external --outfile ./dist/weird-bun-bundle server.mjs",
    "upgrade": "npx @astrojs/upgrade"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/source-code-pro": "^5.1.1",
    "@iconify-json/lucide": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.17",
    "@iconify-json/tabler": "^1.2.13",
    "@react-pdf/renderer": "^4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.4.2",
    "astro-icon": "^1.1.5",
    "express": "^5",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "markdown-to-jsx": "^9.10.3",
    "react": "^19",
    "react-dom": "^19",
    "remark-embed-images": "^5",
    "tailwind-merge": "^3",
    "takumi-js": "^2.17.1",
    "typescript": "^7.0.2",
    "xstate": "^5.28.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/bun": "^1.1.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.39.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "~4.3.3",
    "tsx": "^4.19.2",
    "vfile": "^6.0.3",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "packages/*"
  ]
}
